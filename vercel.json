{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip-root-install",
  "rewrites": [
    { "source": "/api/tour-batch", "destination": "/api/proxy?svc=tour" },
    { "source": "/api/tour/:path*", "destination": "/api/proxy?svc=tour&path=:path*" },
    { "source": "/api/festival-std", "destination": "/api/proxy?svc=festival-std" },
    { "source": "/api/weather", "destination": "/api/proxy?svc=weather" },
    { "source": "/api/templestay/:path*", "destination": "/api/proxy?svc=templestay&path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/sync-places", "schedule": "0 18 * * *" }
  ]
}
